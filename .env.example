# Castglo Frontend Environment Configuration
# Copy this file to .env and provide your specific credentials

# API Base URL for backend services
VITE_API_BASE_URL=https://castglo-qupm.onrender.com/api/v1

# Agora Video / Audio Livestreaming App ID
VITE_AGORA_APP_ID=your_agora_app_id_here

# Stripe Publishable Key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Google OAuth Client ID (Public client ID for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
